{
  "name": "dsh-imagegen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "生成图片：通过 New API 中转站（guaihub 等）调用 OpenAI 风格 /v1/images/generations，并把图片直接显示在 DSH 对话里。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
